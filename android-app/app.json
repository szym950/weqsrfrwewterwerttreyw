{
  "expo": {
    "name": "Wake Up House Zamówienia",
    "slug": "wakeuphouse-orders",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "pl.wakeuphouse.orders",
      "supportsTablet": true
    },
    "android": {
      "package": "pl.wakeuphouse.orders",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b3c4956e-6b67-422f-b412-6e308fc461e9"
      }
    },
    "owner": "kakaroko",
    "plugins": [
      "expo-status-bar",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ]
    ]
  }
}
