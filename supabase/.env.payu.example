# PayU environment for checkout and webhooks. Leave this as sandbox while testing.
PAYU_ENVIRONMENT=sandbox
PAYU_POS_ID=YOUR_SANDBOX_POS_ID
PAYU_CLIENT_ID=YOUR_SANDBOX_OAUTH_CLIENT_ID
PAYU_CLIENT_SECRET=YOUR_SANDBOX_OAUTH_CLIENT_SECRET
PAYU_SECOND_KEY=YOUR_SANDBOX_SECOND_KEY

# Public HTTPS address of the website (no trailing slash).
SITE_URL=https://your-public-website.example
